{
  "name": "todo",
  "version": "1.0.2",
  "description": "Todo Backend using Domain Driven Design (DDD), Hexagonal Architecture, CQRS, Event Sourcing (ES), Event Driven Architecture (EDA), Behaviour Driven Development (BDD) using TypeScript and NestJS. Like what you see? Don't forget to star! ⭐",
  "author": "Bitloops S.A.",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest",
    "test:integration": "RUN_DATABASE_TESTS=true jest --runInBand --runTestsByPath src/bounded-contexts/todo/todo/repository/__tests__/todo-event-store.integration.test.ts src/bounded-contexts/iam/iam/repository/__tests__/user-identity.integration.test.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:frontend": "docker compose -p bitloops-todo-app stop && docker compose -p bitloops-todo-app -f frontend-development.docker-compose.yml up -d",
    "docker:backend": "docker compose -p bitloops-todo-app stop && docker compose -p bitloops-todo-app -f server-development.docker-compose.yml up -d"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "ddd-tactical-core-boilerplate": "^1.0.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "async-mutex": "^0.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "jwks-rsa": "4.0.1",
    "nats": "^2.13.1",
    "pg": "^8.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "jest": "30.2.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.20",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": "(__tests__\\/)(.*)(test|spec|steps)(\\.)(m)?ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.js"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@src/(.*)": "<rootDir>/$1",
      "@modules/(.*)": "<rootDir>/modules/$1",
      "@config/(.*)": "<rootDir>/config/$1",
      "@lib/(.*)": "<rootDir>/lib/$1",
      "@tests/(.*)": "tests/$1"
    }
  }
}
