{
  "name": "frontend-tests",
  "version": "1.0.0",
  "description": "BDD E2E tests for the DDD/CQRS frontend application",
  "main": "src/index.ts",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "NODE_OPTIONS=\"--require ts-node/register --require ./register.js\" cucumber-js --config cucumber.json",
    "test:coverage": "nyc cucumber-js --config cucumber.json",
    "clean": "rm -rf node_modules coverage .nyc_output"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cucumber/cucumber-js-examples.git"
  },
  "keywords": [
    "cucumber",
    "bdd",
    "typescript",
    "example"
  ],
  "nyc": {
    "extension": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx"
    ],
    "exclude": [
      "**/*.d.ts",
      "node_modules/**"
    ],
    "reporter": [
      "html"
    ],
    "all": true,
    "sourceMap": true,
    "instrument": true
  },
  "author": "Matt Wynne",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cucumber/cucumber-js-examples/issues"
  },
  "homepage": "https://github.com/cucumber/cucumber-js-examples#readme",
  "devDependencies": {
    "@babel/cli": "^7.27.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/register": "^7.27.1",
    "@cucumber/cucumber": "^11.3.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "babel-plugin-istanbul": "^7.0.0",
    "cross-env": "^7.0.3",
    "nyc": "^17.1.0",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^4.2.0"
  }
}
